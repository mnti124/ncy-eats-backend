# Copy to .env, then `set -a; source .env; set +a` before `mvn spring-boot:run`,
# or set these in your host's dashboard.

# Supabase → Project Settings → Database → Connect → "Session pooler"
DATABASE_URL="jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password

ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Optional: require this value in an X-Edit-Key header for changes. Blank = open to anyone with the link.
EDIT_KEY=

# Optional: identify yourself to OpenStreetMap (their policy asks for a contact)
OSM_USER_AGENT="nyc-eats/1.0 (you@example.com)"

# Required for "nearby restaurants": free API key from https://www.geoapify.com/
GEOAPIFY_API_KEY=
